<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>vox</string>

	<key>CFBundleIdentifier</key>
	<string>dev.vox.menubar</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>CFBundleName</key>
	<string>Vox</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>

	<key>CFBundleVersion</key>
	<string>0.1.0</string>

	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>

	<!-- LSUIElement = true makes Vox a true menubar/agent app:
	     no Dock icon, no main menu bar, no Cmd-Tab presence. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Required for AVCaptureDevice mic prompts. Shown to the user the
	     first time we touch the microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Vox needs microphone access so it can transcribe what you say into text.</string>
</dict>
</plist>
